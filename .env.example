# ==============================================================================
# Environment Configuration Template (.env.example)
# Property Insurance RAG Assistant
#
# INSTRUCTIONS:
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to Git.
# ==============================================================================

# LLM / OpenAI API Configuration
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Vector Database (ChromaDB / Local Storage)
CHROMA_PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=property_insurance_corpus

# Retrieval & Ingestion Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5

# Logging & Environment
APP_ENV=development
LOG_LEVEL=INFO
